<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="360.0" prefWidth="426.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <VBox layoutX="62.0" layoutY="14.0" prefWidth="320.0" spacing="14.0">
         <children>
            <Label styleClass="login-heading" text="Welcome Back">
               <font>
                  <Font name="Century Schoolbook Bold" size="12.0" />
               </font>
            </Label>
            <Label styleClass="login-description" text="Sign in to continue to your controllers.dashboard." />
            <Label styleClass="input-label" text="Username" />
            <TextField fx:id="txtUserName" prefHeight="44.0" promptText="Enter your username" styleClass="input-field" />
            <Label styleClass="input-label" text="Password" />
            <PasswordField fx:id="txtPassword" onKeyPressed="#txtPasswordOnAction" prefHeight="44.0" promptText="Enter your password" styleClass="input-field" />
            <Label styleClass="forgot-password" text="Forgot password?" />
            <Button fx:id="btnLogIn" mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="46.0" prefWidth="320.0" styleClass="login-button" text="Log In" />
            <Label styleClass="copyright" />
         </children>
      </VBox>
   </children>
</AnchorPane>
